GRAPHQL_ENDPOINT=https://xmcloudcm.localhost/sitecore/api/graph/
GRAPHQL_SCHEMAS=edge,master
GRAPHQL_API_KEY={6D3F291E-66A5-4703-887A-D549AF83D859}
GRAPHQL_HEADERS=
ITEM_SERVICE_DOMAIN=sitecore
ITEM_SERVICE_USERNAME=admin
ITEM_SERVICE_PASSWORD=b
ITEM_SERVICE_SERVER_URL=https://xmcloudcm.localhost/
POWERSHELL_DOMAIN=sitecore
POWERSHELL_USERNAME=admin
POWERSHELL_PASSWORD=b
POWERSHELL_SERVER_URL=https://xmcloudcm.localhost/
# Site (and content database) every script runs under; `shell` matches the Content Editor and
# is where a template's default workflow is applied on create. Empty = no switch.
POWERSHELL_SITE_CONTEXT=shell
POWERSHELL_CONTEXT_DATABASE=master
AUTHORIZATION_HEADER=
# The Authoring and Management GraphQL API. Separate from GRAPHQL_* above: that one talks
# to the Edge/preview endpoints with an sc_apikey, this one talks to the CM's authoring
# schema with an OAuth bearer token.
#
# AUTHORING_ENDPOINT is optional -- it defaults to ITEM_SERVICE_SERVER_URL plus
# /sitecore/api/authoring/graphql/v1/, which is where Sitecore always serves it.
AUTHORING_ENDPOINT=
# Either supply client credentials and let the server mint tokens (recommended: tokens
# expire, and only this route can renew them)...
AUTHORING_CLIENT_ID=
AUTHORING_CLIENT_SECRET=
# ...or paste a token you already hold, e.g. the accessToken in .sitecore/user.json after
# `dotnet sitecore cloud login`. AUTHORING_TOKEN wins when both are set.
AUTHORING_TOKEN=
# Defaults suit SitecoreAI / XM Cloud. Override both for an XM/XP instance authorizing
# against its own Sitecore Identity Server.
AUTHORING_AUTHORITY=https://auth.sitecorecloud.io
AUTHORING_AUDIENCE=https://api.sitecorecloud.io
# WARNING: This disables TLS certificate verification for ALL outbound requests.
# It defaults to 0 because this server is aimed at local development against Sitecore
# instances that use self-signed certificates (e.g. https://xmcloudcm.localhost), and
# XM Cloud / SitecoreAI environments intermittently present certificates Node.js would
# otherwise reject. Disabling verification exposes credentials and API keys to
# man-in-the-middle attacks, so set this to 1 (or remove it) in any production or
# non-trusted network environment.
NODE_TLS_REJECT_UNAUTHORIZED=0